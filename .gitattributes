# Normalize line endings to LF for all text files by default
* text=auto eol=lf

# Explicitly enforce LF on common text formats
*.md        text eol=lf
*.markdown  text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.go        text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# Hugo template overrides
*.html  text eol=lf

# Windows batch files must keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=lf

# Binary files: do not touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary

# Linguist overrides for better GitHub stats
themes/** linguist-vendored
public/** linguist-generated=true
resources/** linguist-generated=true
*.min.css  linguist-generated=true
*.min.js   linguist-generated=true